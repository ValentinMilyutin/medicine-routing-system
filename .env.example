# Задаются только на сервере. Не используйте префикс VITE_:
# переменные VITE_ попадают в клиентскую сборку.
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Добавляется автоматически после подключения Vercel Blob к проекту.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Необязательно: почтовые уведомления об обращениях врачей.
RESEND_API_KEY=re_example
FEEDBACK_FROM_EMAIL="Маршрутизация СМП <routing@example.org>"
PUBLIC_SITE_URL=https://medicine-routing-system.vercel.app
